# IMPORTANT: Put values only in your private .env file. Never commit real keys.
TELEGRAM_BOT_TOKEN=
# Both user API keys are OpenAI, first for regular work, second for failover.
# OPENAI_API_KEY_PRIMARY can be used instead of the legacy OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_API_KEY_SECONDARY=
# Leave Gemini blank unless you also own a Gemini API key.
GEMINI_API_KEY=
PEXELS_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
# Restrict bot to your own numeric Telegram ID (recommended)
ALLOWED_USER_IDS=
OUTPUT_DIR=./jobs
MAX_USER_CLIPS=20
MAX_UPLOAD_MB=19
MAX_SOURCE_MB=70
MAX_CLIPS=8
MAX_DURATION_SECONDS=3600
VIDEO_PRESET=veryfast

# Optional open source project integrations (default disabled)
SCENE_DETECTION=0
SILENCE_CLEANUP=0
WHISPER_MODEL=

# OFF by default: API calls transmit small video frames to selected AI provider.
# The user must additionally run /aiscan openai or /aiscan gemini.
CLOUD_VISION_ENABLED=0
